# ─── Required ────────────────────────────────────────────────
# MongoDB Atlas connection string (Atlas → Connect → Drivers). Payload uses @payloadcms/db-mongodb.
# The database stores documents and media *metadata* only; image/GLB files live in storage (below).
# Leave empty to run the public site in "CV content" preview mode without a database (admin disabled).
DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/pradnya?retryWrites=true&w=majority
# Long random string: `openssl rand -hex 32`
PAYLOAD_SECRET=
# Public origin, no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── File storage (pick ONE; neither = local disk, dev only) ─
# Vercel Blob (simplest on Vercel)
BLOB_READ_WRITE_TOKEN=
# Cloudflare R2 / S3 (recommended once 3D + renders grow — zero egress fees)
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public bucket URL / custom domain, e.g. https://media.pradnyasalunkhe.com
S3_PUBLIC_URL=

# ─── Video (Cloudinary) ─────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Contact form (optional) ────────────────────────────────
# Email notification for new inquiries via Resend (inquiries are always saved in /admin)
RESEND_API_KEY=
CONTACT_NOTIFY_TO=pradnyasalunkhe1212@gmail.com
CONTACT_FROM=Portfolio <inquiries@yourdomain.com>
# Cloudflare Turnstile (optional spam shield)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Analytics (optional, cookieless) ───────────────────────
# Plausible: set domain. Umami: set website id + script URL.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=
