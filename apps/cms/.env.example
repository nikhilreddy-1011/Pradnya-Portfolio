# ─── apps/cms — Payload CMS + API (Render) ─────────────────────────────────────
# Copy to .env for local development. On Render set these in the service → Environment tab.
# EVERYTHING here is private. Nothing in this app is exposed to the browser except
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME (a public cloud name, needed at BUILD time for the admin upload widget).

# ── Required ──
# MongoDB Atlas connection string (Atlas → Connect → Drivers). Database name goes after the host.
DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/pradnya?retryWrites=true&w=majority
# Long random string: `openssl rand -hex 32`. Signs login tokens AND hashes API keys.
# Rotating it logs everyone out and invalidates the website's service API key (generate a new one).
PAYLOAD_SECRET=
# Vercel Blob read-write token (media storage). Production refuses to start without storage.
BLOB_READ_WRITE_TOKEN=
# Public origin of the WEBSITE on Vercel, no trailing slash — CORS, CSRF, preview hand-off, revalidation.
WEB_URL=https://your-portfolio.vercel.app
# Public origin of THIS service. Render provides RENDER_EXTERNAL_URL automatically; set this only if you use a custom domain.
CMS_PUBLIC_URL=

# ── Website integration (same values as on Vercel) ──
# Signs the 60-second draft-preview link: `openssl rand -hex 32`
PREVIEW_SECRET=
# Authorises the CMS → website "content changed" webhook: `openssl rand -hex 32`
REVALIDATE_SECRET=

# ── Video uploads (Cloudinary) — optional ──
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# ── Alternative media storage: Cloudflare R2 / S3 (used instead of Blob when S3_BUCKET is set) ──
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ── Seeding (optional, `npm run seed`) ──
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
