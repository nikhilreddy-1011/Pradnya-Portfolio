{
  "name": "pradnya-portfolio-cms",
  "version": "1.0.0",
  "private": true,
  "description": "Payload CMS + admin + REST API for the Pradnya Salunkhe portfolio (deployed on Render). Data: MongoDB Atlas. Media: Vercel Blob.",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3001",
    "prebuild": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=6000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node scripts/smoke.mjs",
    "unpublish:retired": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/unpublish-retired.ts"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/storage-s3": "3.92.1",
    "@payloadcms/storage-vercel-blob": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "next": "16.4.3",
    "payload": "3.92.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "graphql-scalars": "^2.0.1"
  }
}
