# ─── apps/web — public website (Vercel) ────────────────────────────────────────
# Copy to .env.local for local development. On Vercel set these in Project → Settings → Environment Variables.
# Only variables starting with NEXT_PUBLIC_ are exposed to the browser. Everything else is server-only.

# ── Public (safe to expose) ──
# Public origin of THIS website — canonical URLs, sitemap, Open Graph. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-portfolio.vercel.app
# Cloudinary cloud name (video delivery)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Optional: Turnstile site key, cookieless analytics
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=

# ── Server-only (secrets — never prefix with NEXT_PUBLIC_) ──
# Origin of the CMS service on Render. Leave empty to run the site from the built-in CV content.
CMS_URL=https://pradnya-portfolio-cms.onrender.com
# API key of the CMS user with role "service" (CMS → Users → web-service → Enable API Key).
# Allows ONLY: reading drafts (preview) and creating contact-form inquiries.
CMS_API_KEY=
# Shared with the CMS (same value on both). Signs the 60-second draft-preview link: openssl rand -hex 32
PREVIEW_SECRET=
# Shared with the CMS (same value on both). Authorises the CMS → website "content changed" webhook.
REVALIDATE_SECRET=

# Contact form (all optional — inquiries are always stored in the CMS)
RESEND_API_KEY=
CONTACT_NOTIFY_TO=you@example.com
CONTACT_FROM=Portfolio <inquiries@yourdomain.com>
TURNSTILE_SECRET_KEY=

# Optional: public S3/R2 bucket host so next/image can optimise its files
S3_PUBLIC_URL=
